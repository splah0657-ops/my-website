<style>
:root{--bg:#08090d;--card:#11131a;--text:#f5f7ff;--muted:#a7adbd;--line:#252936;--red:#ff304f;--purple:#7c5cff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;background:radial-gradient(circle at 80% 0%,#24152d 0,#08090d 38%);color:var(--text)}a{text-decoration:none;color:inherit}.wrap{max-width:1100px;margin:auto;padding:0 24px}nav{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px}.logo{font-size:24px;font-weight:900;letter-spacing:2px}.links{display:flex;gap:20px;color:var(--muted);font-size:14px}.links a:hover{color:#fff}.socials{display:flex;gap:9px;align-items:center}.social{width:44px;height:44px;border:1px solid #252832;border-radius:13px;background:#0d0e13;display:grid;place-items:center;transition:.2s}.social:hover{transform:translateY(-2px);border-color:#4a4d59}.social svg{width:21px;height:21px;fill:#e7e9ef}.social.yt:hover{border-color:#ff304f}.social.discord:hover{border-color:#7c5cff}.social.x:hover{border-color:#aaa}.hero{padding:100px 0 80px;text-align:center}.badge{display:inline-block;padding:8px 14px;border:1px solid #343746;border-radius:999px;color:#c7cbe0;background:#10121a}.hero h1{font-size:clamp(48px,9vw,92px);line-height:.95;margin:22px 0 18px}.hero h1 span{background:linear-gradient(90deg,var(--red),var(--purple));-webkit-background-clip:text;color:transparent}.hero p{max-width:650px;margin:auto;color:var(--muted);font-size:18px;line-height:1.7}.buttons{margin-top:30px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.btn{padding:14px 22px;border-radius:12px;background:#fff;color:#08090d;font-weight:800}.btn.red{background:var(--red);color:#fff}.section{padding:70px 0}.title{font-size:34px;margin:0 0 28px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.card{background:linear-gradient(145deg,#141720,#0e1016);border:1px solid var(--line);border-radius:20px;padding:26px;overflow:hidden}.card h3{margin:0 0 10px;font-size:21px}.card p{color:var(--muted);line-height:1.6;margin:0}.yt{border-color:#54202a}.project{padding:0}.project img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.project .project-info{padding:22px 24px 25px}.project-tag{display:inline-block;font-size:12px;color:#ff8b9c;background:#30151c;border:1px solid #5c202d;border-radius:999px;padding:5px 9px;margin-bottom:12px}.software{display:flex;align-items:center;gap:14px}.dot{width:12px;height:12px;border-radius:50%;background:linear-gradient(135deg,var(--red),var(--purple));flex:none}footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);text-align:center}@media(max-width:760px){.links{display:none}.hero{padding-top:70px}}@media(max-width:520px){.social{width:40px;height:40px}nav{height:68px}.wrap{padding:0 16px}}
</style>
